# Copy to apps/web/.env.local and adjust.

# LangGraph Agent Server started by `pnpm dev:api` (langgraphjs dev).
VITE_LANGGRAPH_API_URL=http://localhost:2024

# Grafana base URL for trace links (Explore → Tempo datasource with uid "tempo"). Leave empty to hide the link.
VITE_GRAFANA_URL=http://localhost:3000

# Streaming adapter: "react" (@langchain/react, default) or "legacy" (@langchain/langgraph-sdk/react).
VITE_STREAM_SDK=react
