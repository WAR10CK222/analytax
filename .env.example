# ---------------------------------------------------------------------------
# Analytax — copy to `.env` (repo root). The orchestrator's langgraph.json loads it.
# ---------------------------------------------------------------------------

# Gemini Developer API key (https://aistudio.google.com/apikey)
GOOGLE_API_KEY=

# Where config/, agents/ and skills/ live (defaults to the repo root)
# ANALYTAX_HOME=

# Showcase-only: allow per-run `runOptions.demoFaults` to force adaptive paths
ANALYTAX_ENABLE_FAULTS=false

# Offline demo mode: deterministic stand-in models (no Gemini calls, no API key needed)
ANALYTAX_OFFLINE_MODELS=false

# Logging
LOG_LEVEL=info

# OpenTelemetry exporter:
#   file (default) — JSON lines in logs/telemetry/ (traces-YYYY-MM-DD.jsonl, metrics-YYYY-MM-DD.jsonl); no Docker needed
#   otlp           — send to a collector, e.g. `docker compose up -d` (grafana/otel-lgtm) at OTEL_EXPORTER_OTLP_ENDPOINT
#   none           — disable telemetry (ANALYTAX_TELEMETRY_ENABLED=false does the same)
ANALYTAX_TELEMETRY_EXPORTER=file
# Directory for the file exporter (relative paths resolve from the repo root)
# ANALYTAX_TELEMETRY_DIR=logs/telemetry
OTEL_SERVICE_NAME=analytax-orchestrator
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# Prompt/response content on spans is OFF unless explicitly enabled
OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=false

# Optional: LangSmith tracing in parallel with OTel
LANGSMITH_TRACING=false
# LANGSMITH_API_KEY=
